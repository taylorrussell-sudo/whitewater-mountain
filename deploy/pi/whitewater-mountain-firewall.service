# Optional static unit, pulled in by the LAN edge drop-in.
[Unit]
Description=Whitewater Mountain LAN ingress firewall
After=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/whitewater-mountain/mountain-firewall.nft
ExecStop=/usr/sbin/nft delete table inet whitewater_mountain
